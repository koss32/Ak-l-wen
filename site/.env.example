# Node 24+: node --env-file=.env server.js
HOST=127.0.0.1
PORT=4173
# Supply only on the server. Never put credentials in public assets or Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_AK=
PUBLIC_ORIGIN=
# Persistent writable volume for the idempotency ledger, not a temporary directory.
STATE_DIRECTORY=.state
# Delivery also requires legal.publicationStatus=published and final legal pages.
